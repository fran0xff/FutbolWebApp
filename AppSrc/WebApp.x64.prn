37732>>>        WebSet pbRender of oSaveBtn to False
37733>>>        WebSet pbRender of oCancelChangesBtn to False
37734>>>        WebSet pbRender of oDeleteBtn to False
37735>>>
37735>>>        If (NavigateData.bReadOnly) Begin
37737>>>            WebSet pbRender of oEditBtn to True
37738>>>        End
37738>>>>
37738>>>        Else Begin
37739>>>            WebSet pbRender of oSaveBtn to True
37740>>>            WebSet pbRender of oCancelChangesBtn to True
37741>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37742>>>        End
