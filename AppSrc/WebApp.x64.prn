39230>>>>>    Procedure AnadirPosicionSeleccionada
39233>>>>>        Handle hoJugPosDD
39233>>>>>        String sPosicionId
39233>>>>>        String sJugadorId
39233>>>>>
39233>>>>>        WebGet psSelectedTodasRowId to sPosicionId
39234>>>>>        WebGet psJugadorID to sJugadorId
39235>>>>>        
39235>>>>>        If (sPosicionId = "") Begin
39237>>>>>            Send ShowInfoBox "Selecciona primero una posición de la lista 'Todas las posiciones'."
39238>>>>>            Procedure_Return
39239>>>>>        End
39239>>>>>>
39239>>>>>
39239>>>>>        If (sPosicionId <> "" and sJugadorId <> "") Begin
39241>>>>>            Get Server of oPosicionesJugadorList to hoJugPosDD
39242>>>>>
39242>>>>>            // asegurar el contexto del jugador
39242>>>>>            Send CargarJugador sJugadorId
39243>>>>>
39243>>>>>            // comprobar duplicado por el indice unico (JugadorID + PosicionID)
39243>>>>>            Send Clear of hoJugPosDD
39244>>>>>            Move sJugadorId  to jugadorposicion.JugadorID
39245>>>>>            Move sPosicionId to jugadorposicion.PosicionID
39246>>>>>            Send Find of hoJugPosDD EQ 2
39247>>>>>            If (Found) Begin
39249>>>>>                Send ShowInfoBox "El jugador ya tiene asignada esa posición."
39250>>>>>                Procedure_Return
39251>>>>>            End
39251>>>>>>
39251>>>>>
39251>>>>>            // --- alta normal ---
39251>>>>>            Send Clear of ojugador_DD
39252>>>>>            Move sJugadorId to jugador.ID
39253>>>>>            Send Find of ojugador_DD EQ 1
39254>>>>>
39254>>>>>            Send Clear of hoJugPosDD
39255>>>>>
39255>>>>>            Send Clear of oposicionRel_DD
39256>>>>>            Move sPosicionId to posicion.ID
39257>>>>>            Send Find of oposicionRel_DD EQ 1
39258>>>>>
39258>>>>>            Send Request_Save of hoJugPosDD
39259>>>>>
39259>>>>>            Send CargarJugador sJugadorId
39260>>>>>            Send RefrescarPosicionesJugador
39261>>>>>        End
39261>>>>>>
39261>>>>>    End_Procedure
39262>>>>>    // Busca el jugador recibido y refresca la lista filtrada
39262>>>>>        // Busca el jugador recibido y refresca la lista filtrada
39262>>>>>        // Posiciona la lista de TODAS las posiciones en su primer registro
39262>>>>>    Procedure RefrescarTodasPosiciones
39265>>>>>        Handle hoDD
39265>>>>>        Get Server of oTodasPosicionesList to hoDD
39266>>>>>        Send Clear of hoDD
39267>>>>>        Send Find of hoDD GT 1          // primer registro por índice 1
39268>>>>>        Send UpdateCurrentRowID of oTodasPosicionesList
39269>>>>>        Send GridRefresh of oTodasPosicionesList
39270>>>>>    End_Procedure
39271>>>>>
39271>>>>>    // Posiciona la lista de posiciones del jugador (constreñida) en su primer registro
39271>>>>>    Procedure RefrescarPosicionesJugador
39274>>>>>        Handle hoDD
39274>>>>>        Get Server of oPosicionesJugadorList to hoDD
39275>>>>>        Send Clear of hoDD
39276>>>>>        Send Find of hoDD GT 1          // respeta la constraint por jugador
39277>>>>>        Send UpdateCurrentRowID of oPosicionesJugadorList
39278>>>>>        Send GridRefresh of oPosicionesJugadorList
39279>>>>>    End_Procedure
39280>>>>>
39280>>>>>    // Carga el jugador recibido en el Main_DD (activa la constraint)
39280>>>>>    Procedure CargarJugador String sJugadorId
39283>>>>>        Handle hoDD
39283>>>>>        Get Main_DD to hoDD
39284>>>>>        Send Clear of hoDD
39285>>>>>        Move sJugadorId to jugador.ID
39286>>>>>        Send Find of hoDD EQ 1          // EQ por el índice 1 (clave ID)
39287>>>>>    End_Procedure
39288>>>>>
39288>>>>>    Procedure BorrarPosicionConfirmado Integer eConfirmMode
39291>>>>>        Handle hoJugPosDD
39291>>>>>        String sRowId
39291>>>>>        RowID  riRowID
39291>>>>>        String sJugadorId
39291>>>>>
39291>>>>>        If (eConfirmMode = cmYes) Begin
39293>>>>>            WebGet psCurrentRowId of oPosicionesJugadorList to sRowId
39294>>>>>            WebGet psJugadorID to sJugadorId
39295>>>>>
