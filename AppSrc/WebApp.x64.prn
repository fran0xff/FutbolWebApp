39110>>>        WebSet pbRender of oEditBtn to False
39111>>>        WebSet pbRender of oSaveBtn to False
39112>>>        WebSet pbRender of oCancelChangesBtn to False
39113>>>        WebSet pbRender of oDeleteBtn to False
39114>>>
39114>>>        If (NavigateData.bReadOnly) Begin
39116>>>            WebSet pbRender of oEditBtn to True
39117>>>        End
39117>>>>
39117>>>        Else Begin
39118>>>            WebSet pbRender of oSaveBtn to True
39119>>>            WebSet pbRender of oCancelChangesBtn to True
39120>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39121>>>        End
39121>>>>
39121>>>    End_Procedure
