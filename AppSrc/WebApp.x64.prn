38419>>>        tWebNavigateData NavigateData
38419>>>        tWebNavigateData NavigateData
38419>>>        Boolean bHasRecord
38419>>>        Handle hoDD
38419>>>
38419>>>        Get Server to hoDD
38420>>>        Get GetNavigateData to NavigateData
38421>>>        Get HasRecord of hoDD to bHasRecord
38422>>>
38422>>>        // let's hide all buttons and then Show the ones we want
38422>>>        WebSet pbRender of oEditBtn to False
38423>>>        WebSet pbRender of oSaveBtn to False
38424>>>        WebSet pbRender of oCancelChangesBtn to False
38425>>>        WebSet pbRender of oDeleteBtn to False
38426>>>
38426>>>        If (NavigateData.bReadOnly) Begin
38428>>>            WebSet pbRender of oEditBtn to True
38429>>>        End
38429>>>>
38429>>>        Else Begin
38430>>>            WebSet pbRender of oSaveBtn to True
38431>>>            WebSet pbRender of oCancelChangesBtn to True
38432>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38433>>>        End
38433>>>>
38433>>>    End_Procedure
