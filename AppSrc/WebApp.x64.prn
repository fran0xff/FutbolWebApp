36632>>>>>>>    //
36632>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36632>>>>>>>    //
36632>>>>>>>    //  Params:
36632>>>>>>>    //      dtTime  Time to convert
36632>>>>>>>    //  Returns:
36632>>>>>>>    //      String with "HH:MM:SS" format
36632>>>>>>>    //
36632>>>>>>>    Function TimeToString DateTime dtTime Returns String
36634>>>>>>>        String sHours sMinutes sSeconds
36634>>>>>>>        
36634>>>>>>>        //  Extract parts
36634>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36635>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36636>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36637>>>>>>>        
36637>>>>>>>        //  Fill out with 0
36637>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36640>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36643>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36646>>>>>>>        
36646>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36647>>>>>>>    End_Function
36648>>>>>>>    
36648>>>>>>>    //
36648>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36648>>>>>>>    //
36648>>>>>>>    //  Params:
36648>>>>>>>    //      dtTime  Datetime variable to add time to
36648>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36648>>>>>>>    //  Returns:
36648>>>>>>>    //      dtDateTime with the loaded time
36648>>>>>>>    //
36648>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36650>>>>>>>        String sHours sMinutes sSeconds
36650>>>>>>>        
36650>>>>>>>        //  Extract parts
36650>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36651>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36652>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36653>>>>>>>        
36653>>>>>>>        //  Set to DateTime
36653>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36654>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36655>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36656>>>>>>>        
36656>>>>>>>        Function_Return dtTime
36657>>>>>>>    End_Function
