37749>>>        WebSet pbRender of oSaveBtn to False
37750>>>        WebSet pbRender of oCancelChangesBtn to False
37751>>>        WebSet pbRender of oDeleteBtn to False
37752>>>
37752>>>        If (NavigateData.bReadOnly) Begin
37754>>>            WebSet pbRender of oEditBtn to True
37755>>>        End
37755>>>>
37755>>>        Else Begin
37756>>>            WebSet pbRender of oSaveBtn to True
