38326>>>        Get HasRecord of hoDD to bHasRecord
38327>>>
38327>>>        // let's hide all buttons and then Show the ones we want
38327>>>        WebSet pbRender of oEditBtn to False
38328>>>        WebSet pbRender of oSaveBtn to False
38329>>>        WebSet pbRender of oCancelChangesBtn to False
38330>>>        WebSet pbRender of oDeleteBtn to False
38331>>>
38331>>>        If (NavigateData.bReadOnly) Begin
38333>>>            WebSet pbRender of oEditBtn to True
38334>>>        End
38334>>>>
38334>>>        Else Begin
38335>>>            WebSet pbRender of oSaveBtn to True
38336>>>            WebSet pbRender of oCancelChangesBtn to True
38337>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38338>>>        End
38338>>>>
38338>>>    End_Procedure
