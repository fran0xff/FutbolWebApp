39125>>>        WebSet pbRender of oEditBtn to False
39126>>>        WebSet pbRender of oSaveBtn to False
39127>>>        WebSet pbRender of oCancelChangesBtn to False
39128>>>        WebSet pbRender of oDeleteBtn to False
39129>>>
39129>>>        If (NavigateData.bReadOnly) Begin
39131>>>            WebSet pbRender of oEditBtn to True
39132>>>        End
39132>>>>
39132>>>        Else Begin
39133>>>            WebSet pbRender of oSaveBtn to True
39134>>>            WebSet pbRender of oCancelChangesBtn to True
39135>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39136>>>        End
39136>>>>
39136>>>    End_Procedure
