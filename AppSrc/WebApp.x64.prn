39033>>>        tWebNavigateData NavigateData
39033>>>        tWebNavigateData NavigateData
39033>>>        Boolean bHasRecord
39033>>>        Handle hoDD
39033>>>
39033>>>        Get Server to hoDD
39034>>>        Get GetNavigateData to NavigateData
39035>>>        Get HasRecord of hoDD to bHasRecord
39036>>>
39036>>>        // let's hide all buttons and then Show the ones we want
39036>>>        WebSet pbRender of oEditBtn to False
39037>>>        WebSet pbRender of oSaveBtn to False
39038>>>        WebSet pbRender of oCancelChangesBtn to False
39039>>>        WebSet pbRender of oDeleteBtn to False
39040>>>
39040>>>        If (NavigateData.bReadOnly) Begin
39042>>>            WebSet pbRender of oEditBtn to True
39043>>>        End
39043>>>>
39043>>>        Else Begin
39044>>>            WebSet pbRender of oSaveBtn to True
39045>>>            WebSet pbRender of oCancelChangesBtn to True
39046>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39047>>>        End
39047>>>>
39047>>>    End_Procedure
