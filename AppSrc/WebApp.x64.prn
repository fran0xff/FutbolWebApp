38360>>>        Get HasRecord of hoDD to bHasRecord
38361>>>
38361>>>        // let's hide all buttons and then Show the ones we want
38361>>>        WebSet pbRender of oEditBtn to False
38362>>>        WebSet pbRender of oSaveBtn to False
38363>>>        WebSet pbRender of oCancelChangesBtn to False
38364>>>        WebSet pbRender of oDeleteBtn to False
38365>>>
38365>>>        If (NavigateData.bReadOnly) Begin
38367>>>            WebSet pbRender of oEditBtn to True
