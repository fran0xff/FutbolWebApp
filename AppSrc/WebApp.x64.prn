38533>>>        Get HasRecord of hoDD to bHasRecord
38534>>>
38534>>>        // let's hide all buttons and then Show the ones we want
38534>>>        WebSet pbRender of oEditBtn to False
38535>>>        WebSet pbRender of oSaveBtn to False
38536>>>        WebSet pbRender of oCancelChangesBtn to False
38537>>>        WebSet pbRender of oDeleteBtn to False
38538>>>
38538>>>        If (NavigateData.bReadOnly) Begin
38540>>>            WebSet pbRender of oEditBtn to True
38541>>>        End
38541>>>>
38541>>>        Else Begin
38542>>>            WebSet pbRender of oSaveBtn to True
38543>>>            WebSet pbRender of oCancelChangesBtn to True
38544>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38545>>>        End
38545>>>>
38545>>>    End_Procedure
