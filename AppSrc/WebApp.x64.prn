39518>>>        WebSet pbRender of oEditBtn to False
39519>>>        WebSet pbRender of oSaveBtn to False
39520>>>        WebSet pbRender of oCancelChangesBtn to False
39521>>>        WebSet pbRender of oDeleteBtn to False
39522>>>
39522>>>        If (NavigateData.bReadOnly) Begin
39524>>>            WebSet pbRender of oEditBtn to True
39525>>>        End
39525>>>>
39525>>>        Else Begin
39526>>>            WebSet pbRender of oSaveBtn to True
39527>>>            WebSet pbRender of oCancelChangesBtn to True
39528>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39529>>>        End
