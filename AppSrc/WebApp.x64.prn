39045>>>        Boolean bHasRecord
39045>>>        Handle hoDD
39045>>>
39045>>>        Get Server to hoDD
39046>>>        Get GetNavigateData to NavigateData
39047>>>        Get HasRecord of hoDD to bHasRecord
39048>>>
39048>>>        // let's hide all buttons and then Show the ones we want
39048>>>        WebSet pbRender of oEditBtn to False
39049>>>        WebSet pbRender of oSaveBtn to False
39050>>>        WebSet pbRender of oCancelChangesBtn to False
39051>>>        WebSet pbRender of oDeleteBtn to False
39052>>>
39052>>>        If (NavigateData.bReadOnly) Begin
39054>>>            WebSet pbRender of oEditBtn to True
39055>>>        End
39055>>>>
39055>>>        Else Begin
39056>>>            WebSet pbRender of oSaveBtn to True
39057>>>            WebSet pbRender of oCancelChangesBtn to True
39058>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39059>>>        End
39059>>>>
39059>>>    End_Procedure
