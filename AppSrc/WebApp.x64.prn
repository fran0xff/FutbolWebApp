37766>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37766>>>                Case Break
37767>>>
37767>>>            Case Else // must be nfUndefined
37767>>>
37767>>>        Case End
37767>>>
37767>>>        Send SetActionButtons
