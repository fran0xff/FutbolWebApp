38498>>>                Case Break
38499>>>
38499>>>            Case (NavigateData.eNavigateType = nfFromParent)
38502>>>                // If from parent, this is a constrained drill down.
38502>>>                Case Break
38503>>>
38503>>>            Case (NavigateData.eNavigateType = nfFromChild)
38506>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38506>>>                Case Break
38507>>>
38507>>>            Case Else // must be nfUndefined
38507>>>
38507>>>        Case End
38507>>>
38507>>>        Send SetActionButtons
38508>>>
38508>>>    End_Procedure
