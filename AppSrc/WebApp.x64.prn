38449>>>                Case Break
38450>>>
38450>>>            Case (NavigateData.eNavigateType = nfFromParent)
38453>>>                // If from parent, this is a constrained drill down.
38453>>>                Case Break
38454>>>
38454>>>            Case (NavigateData.eNavigateType = nfFromChild)
38457>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38457>>>                Case Break
38458>>>
38458>>>            Case Else // must be nfUndefined
38458>>>
38458>>>        Case End
38458>>>
38458>>>        Send SetActionButtons
38459>>>
38459>>>    End_Procedure
