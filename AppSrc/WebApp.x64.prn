38420>>>        tWebNavigateData NavigateData
38420>>>        tWebNavigateData NavigateData
38420>>>        Boolean bHasRecord
38420>>>        Handle hoDD
38420>>>
38420>>>        Get Server to hoDD
38421>>>        Get GetNavigateData to NavigateData
38422>>>        Get HasRecord of hoDD to bHasRecord
38423>>>
38423>>>        // let's hide all buttons and then Show the ones we want
38423>>>        WebSet pbRender of oEditBtn to False
38424>>>        WebSet pbRender of oSaveBtn to False
38425>>>        WebSet pbRender of oCancelChangesBtn to False
38426>>>        WebSet pbRender of oDeleteBtn to False
38427>>>
38427>>>        If (NavigateData.bReadOnly) Begin
38429>>>            WebSet pbRender of oEditBtn to True
38430>>>        End
38430>>>>
38430>>>        Else Begin
38431>>>            WebSet pbRender of oSaveBtn to True
38432>>>            WebSet pbRender of oCancelChangesBtn to True
38433>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38434>>>        End
38434>>>>
38434>>>    End_Procedure
