38465>>>    Procedure SetActionButtons
38468>>>        tWebNavigateData NavigateData
38468>>>        tWebNavigateData NavigateData
38468>>>        Boolean bHasRecord
38468>>>        Handle hoDD
38468>>>
38468>>>        Get Server to hoDD
38469>>>        Get GetNavigateData to NavigateData
38470>>>        Get HasRecord of hoDD to bHasRecord
38471>>>
38471>>>        // let's hide all buttons and then Show the ones we want
38471>>>        WebSet pbRender of oEditBtn to False
38472>>>        WebSet pbRender of oSaveBtn to False
38473>>>        WebSet pbRender of oCancelChangesBtn to False
38474>>>        WebSet pbRender of oDeleteBtn to False
38475>>>
38475>>>        If (NavigateData.bReadOnly) Begin
38477>>>            WebSet pbRender of oEditBtn to True
38478>>>        End
38478>>>>
38478>>>        Else Begin
38479>>>            WebSet pbRender of oSaveBtn to True
38480>>>            WebSet pbRender of oCancelChangesBtn to True
38481>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38482>>>        End
38482>>>>
38482>>>    End_Procedure
