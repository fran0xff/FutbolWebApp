39540>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39543>>>        Case Begin
39543>>>            Case (NavigateData.eNavigateType = nfFromMain)
39545>>>                // If from main, this is a propbably a main file Select to Zoom.
39545>>>                Case Break
39546>>>
39546>>>            Case (NavigateData.eNavigateType = nfFromParent)
39549>>>                // If from parent, this is a constrained drill down.
39549>>>                Case Break
39550>>>
39550>>>            Case (NavigateData.eNavigateType = nfFromChild)
39553>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39553>>>                Case Break
39554>>>
39554>>>            Case Else // must be nfUndefined
39554>>>
39554>>>        Case End
39554>>>
39554>>>        Send SetActionButtons
39555>>>
39555>>>    End_Procedure
